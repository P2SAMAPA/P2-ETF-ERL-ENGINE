   "metadata": {},
   "source": ["# REALM Monday Training\n", "**Full pipeline:** HMM → TFT → DDPG A/B/C → ERL → Internalize\n\n", "**Schedule:** Monday 02:00 UTC\n", "**GPU:** T4 x2\n", "**Est. runtime:** ~13 hours"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 0. Install dependencies ────────────────────────────────────────────────\n",
    "import subprocess, sys\n",
    "\n",
    "subprocess.run([\n",
    "    sys.executable, '-m', 'pip', 'install', '-q',\n",
    "    '-r', '/kaggle/working/repo/requirements_kaggle.txt'\n",
    "], check=True)\n",
    "print('Dependencies installed')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 1. Clone repo ──────────────────────────────────────────────────────────\n",
    "import subprocess, sys, os\n",
    "\n",
    "repo_path = '/kaggle/working/repo'\n",
    "if not os.path.exists(repo_path):\n",
    "    subprocess.run([\n",
    "        'git', 'clone',\n",
    "        'https://github.com/P2SAMAPA/P2-ETF-ERL-ENGINE.git',\n",
    "        repo_path\n",
    "    ], check=True)\n",
    "else:\n",
    "    subprocess.run(['git', '-C', repo_path, 'pull'], check=True)\n",
    "\n",
    "sys.path.insert(0, repo_path)\n",
    "print(f'Repo ready at {repo_path}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 2. Load secrets ────────────────────────────────────────────────────────\n",
    "import os\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "\n",
    "secrets = UserSecretsClient()\n",
    "os.environ['HF_TOKEN']        = secrets.get_secret('HF_TOKEN')\n",
    "os.environ['HF_SOURCE_REPO']  = secrets.get_secret('HF_SOURCE_REPO')\n",
    "os.environ['HF_MODELS_REPO']  = secrets.get_secret('HF_MODELS_REPO')\n",
    "os.environ['HF_RESULTS_REPO'] = secrets.get_secret('HF_RESULTS_REPO')\n",
    "os.environ['GEMINI_API_KEY']  = secrets.get_secret('GEMINI_API_KEY')\n",
    "print('Secrets loaded')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 3. Validate config ─────────────────────────────────────────────────────\n",
    "os.chdir(repo_path)\n",
    "import config as cfg\n",
    "cfg.validate()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 4. HMM Training (~5 min, CPU) ─────────────────────────────────────────\n",
    "from hmm_train import main as hmm_main\n",
    "hmm_main()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 5. TFT Training (~3 hrs, GPU) ─────────────────────────────────────────\n",
    "from tft_train import main as tft_main\n",
    "tft_main()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 6. DDPG Training — Policies A, B, C (~4 hrs, GPU) ─────────────────────\n",
    "from ddpg_train import main as ddpg_main\n",
    "ddpg_main()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 7. ERL Training (~6 hrs, GPU) ─────────────────────────────────────────\n",
    "from erl_train import main as erl_main\n",
    "erl_main()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 8. Summary ─────────────────────────────────────────────────────────────\n",
    "import json, os\n",
    "\n",
    "for fname in ['ddpg_summary.json', 'erl_summary.json', 'sft_summary.json']:\n",
    "    path = os.path.join(cfg.LOCAL_TMP, fname)\n",
    "    if os.path.exists(path):\n",
    "        with open(path) as f:\n",
    "            print(f'\\n── {fname} ──')\n",
    "            print(json.dumps(json.load(f), indent=2))\n",
    "\n",
    "print('\\nMonday training complete')"
   ]
  }
